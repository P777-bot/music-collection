generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Artist {
  id    Int    @id @default(autoincrement())
  name  String @unique
  songs Song[]
}

model User {
  id           Int        @id @default(autoincrement())
  email        String     @unique
  passwordHash String
  createdAt    DateTime   @default(now())
  role         UserRole   @default(USER)
  favorites    Favorite[]
  ownedSongs   Song[]     @relation("SongOwner")
}

model Song {
  id          Int         @id @default(autoincrement())
  album       String
  genre       String
  artistId    Int
  name        String
  releaseDate DateTime    @db.Date
  coverUrl    String?
  createdById Int?
  youtubeUrl  String?
  lyrics      String?
  favorites   Favorite[]
  artist      Artist      @relation(fields: [artistId], references: [id])
  createdBy   User?       @relation("SongOwner", fields: [createdById], references: [id])
  genres      SongGenre[]

  @@unique([artistId, album, name])
  @@index([createdById])
}

model Genre {
  id             Int          @id @default(autoincrement())
  name           String       @unique
  normalizedName String       @unique
  parentId       Int?
  parent         Genre?       @relation("GenreHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  subgenres      Genre[]      @relation("GenreHierarchy")
  aliases        GenreAlias[]
  songs          SongGenre[]
}

model GenreAlias {
  aliasKey String @id
  genreId  Int
  genre    Genre  @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@index([genreId])
}

model SongGenre {
  songId  Int
  genreId Int
  genre   Genre @relation(fields: [genreId], references: [id])
  song    Song  @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@id([songId, genreId])
  @@index([genreId])
}

model Favorite {
  userId    Int
  songId    Int
  createdAt DateTime @default(now())
  song      Song     @relation(fields: [songId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, songId])
  @@index([songId])
}

enum UserRole {
  USER
  ADMIN
}
